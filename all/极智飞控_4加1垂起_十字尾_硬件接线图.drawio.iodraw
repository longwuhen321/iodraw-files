        <mxCell id="p2_0211" value="本版为信号接线图；动力、舵机供电与 BEC 分配从主图省略，实机仍须按规格连接。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=26;fontColor=#64758A;fontStyle=0;lineHeight=1.35;" parent="1" vertex="1">
