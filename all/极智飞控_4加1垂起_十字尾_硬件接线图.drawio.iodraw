          </mxGeometry>
        </mxCell>
        <mxCell id="p2_0204" value="CH9 为快门触发，CH11 为热靴反馈；&#xa;快门按高 / 低电平配置，不支持 PWM 快门线。〔第 3–4、11 页〕" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=28;fontColor=#243447;fontStyle=0;lineHeight=1.4;" parent="1" vertex="1">
