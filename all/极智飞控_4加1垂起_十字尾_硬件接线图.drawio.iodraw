        </mxCell>
        <mxCell id="p2_0205" value="图纸范围与实机参数" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=32;fontColor=#163A5F;fontStyle=1;lineHeight=1.35;" parent="1" vertex="1">
          <mxGeometry x="2025" y="2227" width="1800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2_0206" value="本版省略动力、舵机供电及 BEC 分配线路。&#xa;实机仍需按设备规格供电，电调和舵机保留 S / GND 连接。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=28;fontColor=#243447;fontStyle=0;lineHeight=1.4;" parent="1" vertex="1">
          <mxGeometry x="2025" y="2290" width="1830" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_0207" value="飞控型号 / 版本、电池串数、BEC 输出电压、外设供电及针号待填。&#xa;A4 外壳标 3–12S、正文为 3–14S，需按实际硬件资料核对。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=28;fontColor=#243447;fontStyle=0;lineHeight=1.4;" parent="1" vertex="1">
          <mxGeometry x="2025" y="2390" width="1830" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2_0208" value="未绘制供电线不表示无需供电；选配按实际设备与对应配置启用。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=27;fontColor=#64758A;fontStyle=0;lineHeight=1.35;" parent="1" vertex="1">
