          <mxGeometry x="55" y="1940" width="2290" height="265" as="geometry" />
        </mxCell>
        <mxCell id="unused_header" value="未接入本机设备的针脚" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=25;fontColor=#193B55;fontStyle=1;lineHeight=1.3;" vertex="1" parent="1">
          <mxGeometry x="80" y="1958" width="1290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="unused_header_note" value="未使用功能脚、NC、BOOT 与默认悬空分别标识；完整定义见第 2 页。" style="text;html=0;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=19;fontColor=#5C7082;fontStyle=0;lineHeight=1.3;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1960" width="1195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="unused_final_note" value="18 / 37 已按 CAN 接线&#xa;串口 6 为同针复用定义" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=20;fontColor=#835AB5;fontStyle=0;lineHeight=1.3;" vertex="1" parent="1">
