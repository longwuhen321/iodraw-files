        <mxCell id="ref_mux_reminder_bg" value="" style="shape=rectangle;html=0;fillColor=#F5F0FA;strokeColor=#D9CBEA;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1792" width="1100" height="53" as="geometry" />
        </mxCell>
        <mxCell id="ref_mux_reminder" value="复用关系：18 = TX232_6 或 CANL；37 = RX232_6 或 CANH。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#835AB5;fontStyle=1;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1795" width="1060" height="47" as="geometry" />
        </mxCell>
        <mxCell id="ref_notes_bg" value="" style="shape=rectangle;html=0;fillColor=#F7FAFC;strokeColor=#C7D4DE;strokeWidth=1.5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1885" width="2240" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ref_notes_title" value="接线条件与资料边界" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=25;fontColor=#193B55;fontStyle=1;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="1900" width="2170" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_1" value="供电：VSER（20/22/23）与 PGND（1/3/4）分别内部共连；手册允许 DC4.0–9.0V。原图 Pow/Pow2 标注 4.5–9V。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="1946" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_2" value="拟分配：Pow → 20/1、Pow2 → 22/3 为本次拟定针位；原文件未细化到针号，须以实物线束确认。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="1986" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_3" value="采样：ADC1 电流配置输入 0～5.24V；电池测压须使用专用 2 路测量线及对应配置。ADC2 输入范围 0～52V。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="2026" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_4" value="控制：DO2/DO3 外翼与 DO1 启动用途沿用原图，需核对配置及驱动接口；DO1 输出电流为 4mA。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="2066" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_5" value="更新：BOOT 更新说明提及 VCC3；VCC5 是内部电源，严禁外部使用。两者均不新增为本插座针脚。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="2106" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_note_6" value="复用：18/37 由出厂内部跳线电阻设定；本图沿用原图 CAN 用途（18 = L，37 = H），模式仍需核对。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#293D4B;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="110" y="2146" width="2175" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ref_source" value="资料来源：S40U 固定翼版用户手册第 11–14 页；《创衡S40U飞控-四舵面飞翼机型.iodraw》。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=fill;spacing=0;fontFamily=Microsoft YaHei,Noto Sans CJK SC,Arial,sans-serif;fontSize=21;fontColor=#667887;fontStyle=0;lineHeight=1.24;" vertex="1" parent="1">
          <mxGeometry x="82" y="2234" width="2236" height="40" as="geometry" />
        </mxCell>
        <mxCell id="2" value="接线" parent="0" />
      </root>
    </mxGraphModel>
