    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="&lt;b&gt;PX4 v1.15.4 固定翼 TECS 参数索引（配套主图）&lt;/b&gt;&lt;br&gt;第1页看控制骨架；本页只做分类索引，不展开源码细节" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontSize=24;fontStyle=1;fontSize=24;align=center;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="120" y="20" width="2140" height="60" />
        </mxCell>
        <mxCell id="idx1" value="&lt;b&gt;1. 高度控制 / 参考轨迹&lt;/b&gt;&lt;br&gt;FW_T_ALT_TC&lt;br&gt;FW_T_HRATE_FF&lt;br&gt;FW_T_CLMB_R_SP&lt;br&gt;FW_T_SINK_R_SP&lt;br&gt;FW_T_CLMB_MAX&lt;br&gt;FW_T_SINK_MIN&lt;br&gt;FW_T_SINK_MAX&lt;br&gt;FW_T_VERT_ACC" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="140" y="150" width="460" height="290" />
        </mxCell>
        <mxCell id="idx2" value="&lt;b&gt;2. 空速控制 / 估计&lt;/b&gt;&lt;br&gt;FW_T_TAS_TC&lt;br&gt;FW_T_SPD_STD&lt;br&gt;FW_T_SPD_DEV_STD&lt;br&gt;FW_T_SPD_PRC_STD&lt;br&gt;FW_AIRSPD_STALL&lt;br&gt;FW_AIRSPD_MIN&lt;br&gt;FW_AIRSPD_TRIM&lt;br&gt;FW_AIRSPD_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="700" y="150" width="460" height="290" />
        </mxCell>
        <mxCell id="idx3" value="&lt;b&gt;3. Pitch / SEB 支路&lt;/b&gt;&lt;br&gt;FW_T_SPDWEIGHT&lt;br&gt;FW_T_PTCH_DAMP&lt;br&gt;FW_T_I_GAIN_PIT&lt;br&gt;FW_T_SEB_R_FF&lt;br&gt;FW_P_LIM_MIN&lt;br&gt;FW_P_LIM_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1260" y="150" width="460" height="260" />
        </mxCell>
        <mxCell id="idx4" value="&lt;b&gt;4. Throttle / STE 支路&lt;/b&gt;&lt;br&gt;FW_T_THR_DAMPING&lt;br&gt;FW_T_THR_INTEG&lt;br&gt;FW_T_STE_R_TC&lt;br&gt;FW_T_RLL2THR&lt;br&gt;FW_THR_MIN&lt;br&gt;FW_THR_TRIM&lt;br&gt;FW_THR_MAX&lt;br&gt;FW_THR_SLEW_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1820" y="150" width="420" height="290" />
        </mxCell>
        <mxCell id="idx5" value="&lt;b&gt;5. 外围性能模型&lt;/b&gt;&lt;br&gt;PerformanceModel&lt;br&gt;部分 CLMB/SINK/Trim airspeed&lt;br&gt;部分空速边界&lt;br&gt;会先经过重量/密度等修正&lt;br&gt;再进入 TECS" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="360" y="560" width="620" height="220" />
        </mxCell>
        <mxCell id="idx6" value="&lt;b&gt;6. 阅读建议&lt;/b&gt;&lt;br&gt;先看第1页：主控制骨架&lt;br&gt;再回到本页：按类别查参数&lt;br&gt;若后续需要，可再扩展第3页&lt;br&gt;专门做 参数—源码—ulog 对应图" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=14;align=left;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1120" y="560" width="760" height="220" />
        </mxCell>
        <mxCell id="footer2" value="&lt;b&gt;说明&lt;/b&gt;&lt;br&gt;本次重做优先解决“主图可读性差”的问题，因此不再把大量源码细节压进主图。&lt;br&gt;如果你认可这一版风格，下一轮可以在此基础上继续精细化，例如把第3页补成源码映射页。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.4;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;fontSize=14;align=left;" parent="1" vertex="1">
