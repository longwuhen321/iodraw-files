        <mxCell id="ste" value="&lt;b&gt;STE Rate（总能量率）&lt;/b&gt;&lt;br&gt;_calcThrottleControlSteRate()&lt;br&gt;STE = SPE + SKE&lt;br&gt;+ FW_T_RLL2THR × (load_factor - 1)&lt;br&gt;限幅由 CLMB/SINK 性能换算" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="1580" y="790" width="390" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ste_filter" value="&lt;b&gt;STE Rate Estimate Filter&lt;/b&gt;&lt;br&gt;FW_T_STE_R_TC&lt;br&gt;_ste_rate_estimate_filter" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="2040" y="785" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="thr_ctrl" value="&lt;b&gt;Throttle 总能量控制&lt;/b&gt;&lt;br&gt;_calcThrottleControlOutput()&lt;br&gt;预测油门：FW_THR_TRIM + STE rate 映射&lt;br&gt;FW_T_THR_DAMPING：STE rate 误差反馈&lt;br&gt;FW_T_THR_INTEG：积分" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;" parent="1" vertex="1">
