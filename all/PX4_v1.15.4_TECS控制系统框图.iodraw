        <mxCell id="thr_limit" value="&lt;b&gt;Throttle 变化率与边界&lt;/b&gt;&lt;br&gt;FW_THR_SLEW_MAX&lt;br&gt;FW_THR_MIN / FW_THR_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=center;" parent="1" vertex="1">
