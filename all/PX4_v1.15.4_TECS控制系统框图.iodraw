        <mxCell id="air_sp" value="&lt;b&gt;空速目标&lt;/b&gt;&lt;br&gt;Equivalent Airspeed SP&lt;br&gt;转换为 TAS setpoint" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="60" y="560" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="air_state" value="&lt;b&gt;空速测量 / 导数&lt;/b&gt;&lt;br&gt;equivalent_airspeed&lt;br&gt;speed_deriv_forward" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="60" y="720" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="roll_state" value="&lt;b&gt;横滚 / 载荷因子&lt;/b&gt;&lt;br&gt;getLoadFactor()&lt;br&gt;供转弯能量补偿" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="60" y="1040" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="alt_ref" value="&lt;b&gt;高度参考模型&lt;/b&gt;&lt;br&gt;TECSAltitudeReferenceModel::update()&lt;br&gt;FW_T_CLMB_R_SP / FW_T_SINK_R_SP&lt;br&gt;FW_T_VERT_ACC&lt;br&gt;输出：altitude_reference / height_rate_reference" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="420" y="120" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="alt_outer" value="&lt;b&gt;高度外环&lt;/b&gt;&lt;br&gt;TECSControl::_calcAltitudeControlOutput()&lt;br&gt;(h_ref - h) × (1/FW_T_ALT_TC)&lt;br&gt;+ FW_T_HRATE_FF × hdot_ref&lt;br&gt;限幅：FW_T_CLMB_MAX / FW_T_SINK_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" parent="1" vertex="1">
