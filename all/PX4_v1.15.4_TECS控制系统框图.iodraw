        <mxCell id="hr_sp" value="&lt;b&gt;Altitude Rate SP&lt;/b&gt;&lt;br&gt;height_rate_setpoint" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="1280" y="170" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="air_filter" value="&lt;b&gt;TECS 空速滤波&lt;/b&gt;&lt;br&gt;TECSAirspeedFilter::update()&lt;br&gt;FW_T_SPD_STD&lt;br&gt;FW_T_SPD_DEV_STD&lt;br&gt;FW_T_SPD_PRC_STD&lt;br&gt;输出：filtered TAS / TAS rate" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="420" y="610" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="air_outer" value="&lt;b&gt;空速外环&lt;/b&gt;&lt;br&gt;TECSControl::_calcAirspeedControlOutput()&lt;br&gt;(TAS_sp - TAS) × (1/FW_T_TAS_TC)&lt;br&gt;TAS rate 限幅由 STE 性能边界派生" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="840" y="600" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tas_rate_sp" value="&lt;b&gt;TAS Rate SP&lt;/b&gt;&lt;br&gt;true_airspeed_derivative_sp" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="1280" y="635" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="energy_conv" value="&lt;b&gt;能量率转换&lt;/b&gt;&lt;br&gt;TECSControl::_calcSpecificEnergyRates()&lt;br&gt;SPE_rate_sp = height_rate_sp × g&lt;br&gt;SKE_rate_sp = TAS × TAS_rate_sp&lt;br&gt;估计值来自 altitude_rate / filtered TAS rate" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="1580" y="360" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="underspeed" value="&lt;b&gt;欠速检测与权重&lt;/b&gt;&lt;br&gt;_detectUnderspeed()&lt;br&gt;_updateSpeedAltitudeWeights()&lt;br&gt;FW_T_SPDWEIGHT&lt;br&gt;FW_AIRSPD_MIN / FW_AIRSPD_TRIM&lt;br&gt;欠速时速度权重逐步趋向 2" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="1580" y="90" width="390" height="210" as="geometry" />
        </mxCell>
        <mxCell id="seb" value="&lt;b&gt;SEB Rate（能量平衡率）&lt;/b&gt;&lt;br&gt;_calcPitchControlSebRate()&lt;br&gt;SEB = w_SPE·SPE - w_SKE·SKE" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="2040" y="90" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pitch_ctrl" value="&lt;b&gt;Pitch 能量平衡控制&lt;/b&gt;&lt;br&gt;_calcPitchControlOutput()&lt;br&gt;FW_T_PTCH_DAMP：SEB rate 误差反馈&lt;br&gt;FW_T_SEB_R_FF：SEB rate 前馈&lt;br&gt;FW_T_I_GAIN_PIT：积分" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="2040" y="245" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="pitch_limit" value="&lt;b&gt;Pitch 变化率与角度边界&lt;/b&gt;&lt;br&gt;FW_T_VERT_ACC → pitch increment limit&lt;br&gt;FW_P_LIM_MIN / FW_P_LIM_MAX" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="2040" y="455" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pitch_sp" value="&lt;b&gt;Pitch Setpoint&lt;/b&gt;&lt;br&gt;tecs_status.pitch_sp_rad&lt;br&gt;继续进入固定翼姿态控制器" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;" parent="1" vertex="1">
