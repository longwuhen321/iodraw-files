        <mxCell id="alt_sp" value="&lt;b&gt;高度目标 / 高度率输入&lt;/b&gt;&lt;br&gt;Altitude SP / Height-rate SP&lt;br&gt;Mission / Position / Altitude 等" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;" parent="1" vertex="1">
          <mxGeometry x="60" y="140" width="280" height="100" as="geometry" />
